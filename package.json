{
  "name": "rama-agi",
  "private": true,
  "version": "1.0.0",
  "description": "Rama - Supreme AGI Desktop. Superset of StockMind AI.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.cjs\"",
    "dev:renderer": "vite",
    "dev:server": "node server/index.cjs",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "electron": "electron .",
    "preview": "vite preview",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "argon2": "0.43.0",
    "axios": "1.7.9",
    "chokidar": "3.6.0",
    "concurrently": "9.1.2",
    "cors": "2.8.5",
    "electron-updater": "6.3.9",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "mongodb": "6.12.0",
    "node-pty": "1.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.6.0",
    "recharts": "2.15.3",
    "simple-git": "3.27.0",
    "systeminformation": "5.23.5",
    "wait-on": "8.0.1",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "vite": "6.3.5"
  },
  "build": {
    "appId": "com.krishnaprasad.rama-agi",
    "productName": "Rama AGI",
    "directories": { "output": "dist-electron" },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "ai_backend", "to": "ai_backend", "filter": ["**/*"] }
    ]
  }
}
