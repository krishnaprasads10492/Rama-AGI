# ═══════════════════════════════════════════════════════════════
# RĀMA AGI — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
SERVER_PORT=4097

# ── AI Providers (set the one you use) ──────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
OLLAMA_BASE_URL=http://localhost:11434

# ── MongoDB (Phase 2 — persistent memory) ───────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=rama_agi

# ── GitHub (Git Sync Bridge) ─────────────────────────────────────
GITHUB_TOKEN=ghp_...         # expires Oct 17 2026 — renew before then
STOCKMIND_REPO=krishnaprasads10492/STOCKMIND_AI
STOCKMIND_BRANCH=stockmind-source
RAMA_REPO=krishnaprasads10492/Rama-AGI
RAMA_BRANCH=source

# ── Security ─────────────────────────────────────────────────────
# Master password is set at first launch — NOT stored in .env
# DATA_PASSWORD is used as Argon2id input for key derivation
# HMAC_SECRET is used for payload signing
HMAC_SECRET=change-this-to-a-random-64-char-string

# ── StockMind (assimilated module) ───────────────────────────────
STOCKMIND_VITE_PORT=4099
STOCKMIND_SERVER_PORT=4098
STOCKMIND_PYTHON_PORT=8001
